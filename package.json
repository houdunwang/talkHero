{
  "name": "houdunyun-ruyi",
  "title": "后盾云桌面助手",
  "version": "2.1.36",
  "description": "后盾云桌面助手",
  "main": "./out/main/index.js",
  "author": "后盾云",
  "homepage": "https://www.houdunyun.com",
  "scripts": {
    "clean": "node ./scripts/clean-dist.cjs",
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "test": "vitest run",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "start": "node ./scripts/run-electron-vite.cjs preview",
    "dev": "node ./scripts/run-electron-vite.cjs dev --watch",
    "build": "pnpm run clean && pnpm run typecheck && node ./scripts/run-electron-vite.cjs build",
    "debug:win:dir": "pnpm run clean && pnpm run build && electron-builder --win --x64 --dir && node -e \"const fs=require('fs');const path=require('path');const dir=path.join(process.cwd(),'dist','win-unpacked');const exists=fs.existsSync(dir);const files=exists?fs.readdirSync(dir).filter(f=>f.toLowerCase().endsWith('.exe')):[];process.stdout.write(JSON.stringify({dir,exists,files}, null, 2)+'\\n')\"",
    "postinstall": "node ./scripts/ensure-electron.cjs && electron-builder install-app-deps",
    "build:web:win": "node ./scripts/build-win.cjs",
    "build:web:mac": "./scripts/build-mac-web.sh",
    "build:web:mac:quick": "pnpm run clean && electron-vite build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --arm64 --dir",
    "check:web:mac": "./scripts/notarize-check.sh"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@base-ui/react": "^1.7.0",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron/get": "^5.1.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.27",
    "@tanstack/router-plugin": "^1.168.30",
    "@tanstack/virtual-file-routes": "^1.162.0",
    "@types/node": "^22.20.1",
    "@types/nprogress": "^0.2.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "ahooks": "^3.9.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.21",
    "electron": "39.2.6",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "jotai": "^2.20.2",
    "lucide-react": "^0.545.0",
    "nprogress": "^0.2.0",
    "pinyin-pro": "^3.29.1",
    "prettier": "^3.9.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-dropzone": "^15.0.0",
    "react-spinners": "^0.17.0",
    "shadcn": "4.13.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b"
}
